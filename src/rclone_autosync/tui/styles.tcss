/* Base screen styling */
Screen {
    background: #0f172a;
    color: #e2e8f0;
}

Header {
    background: #1e293b;
    color: #38bdf8;
    text-style: bold;
    height: 1;
}

Footer {
    background: #1e293b;
    color: #94a3b8;
    height: 1;
}

/* Tabbed Navigation */
TabbedContent {
    height: 1fr;
}

ContentSwitcher {
    height: 1fr;
}

TabPane {
    height: 1fr;
    padding: 0;
}

ContentTab {
    padding: 0 2;
    color: #94a3b8;
}

ContentTab:hover {
    color: #38bdf8;
    background: #1e293b;
}

ContentTab.-active {
    color: #38bdf8;
    background: #0f172a;
    text-style: bold;
}

/* Dashboard screen */
#dashboard-container {
    height: 1fr;
    padding: 1 2;
}

#dashboard-container > Vertical {
    height: 1fr;
}

#profiles-header-box {
    layout: horizontal;
    height: 3;
    align: left middle;
    margin-bottom: 1;
}

#profiles-header-box > Horizontal:first-child {
    width: auto;
    align: left middle;
}

#profiles-header-box > Horizontal:last-child {
    width: 1fr;
    align: right middle;
}

#profiles-table {
    height: 1fr;
    border: round #334155;
    background: #1e293b;
}

#profiles-table:focus {
    border: round #38bdf8;
}

#empty-profiles-notice {
    height: auto;
    padding: 1 2;
    margin: 1 0;
    border: dashed #475569;
    background: #1e293b;
    color: #94a3b8;
    text-align: center;
}

#transfer-card {
    height: auto;
    max-height: 14;
    min-height: 5;
    margin-top: 1;
    padding: 1 2;
    border: round #0284c7;
    background: #1e293b;
}

.card-title {
    color: #38bdf8;
    text-style: bold;
}

.stat-label {
    color: #94a3b8;
}

.stat-value {
    color: #f8fafc;
    text-style: bold;
}

/* Status Pills */
.status-pill {
    padding: 0 1;
    text-style: bold;
}

.status-watching {
    color: #10b981;
}

.status-syncing {
    color: #06b6d4;
}

.status-queued {
    color: #f59e0b;
}

.status-idle {
    color: #94a3b8;
}

.status-error {
    color: #ef4444;
}

.status-disabled {
    color: #64748b;
}

/* Explorer screen */
#explorer-container {
    height: 1fr;
    padding: 1 2;
}

#explorer-container > Horizontal {
    height: 1fr;
    width: 100%;
}

.explorer-pane {
    width: 1fr;
    height: 1fr;
    border: round #334155;
    background: #1e293b;
    padding: 1;
    margin: 0 1;
}

#local-directory-tree {
    height: 1fr;
    border: solid #334155;
    background: #0f172a;
}

.pane-title {
    text-style: bold;
    color: #38bdf8;
    margin-bottom: 1;
}

#remote-dirs-list {
    height: 1fr;
    border: solid #334155;
    background: #0f172a;
}

#remote-controls {
    height: 3;
    align: left middle;
    margin-bottom: 1;
}

#remote-controls > Select {
    width: 1fr;
}

#explorer-actions {
    height: 3;
    margin-top: 1;
    align: left middle;
}

/* Daemon view */
#daemon-container {
    height: 1fr;
    padding: 1 2;
}

#daemon-container > Vertical {
    height: 1fr;
}

#daemon-status-box {
    height: 4;
    border: round #334155;
    background: #1e293b;
    padding: 1;
    layout: horizontal;
    align: left middle;
    margin-bottom: 1;
}

#daemon-actions {
    layout: horizontal;
    height: 3;
    margin-bottom: 1;
}

#daemon-log-view {
    height: 1fr;
    border: round #334155;
    background: #0f172a;
    padding: 1;
}

/* Modals */
ModalScreen {
    align: center middle;
    background: rgba(15, 23, 42, 0.85);
}

#modal-dialog {
    width: 72;
    height: auto;
    max-height: 85%;
    border: double #38bdf8;
    background: #1e293b;
    padding: 1 2;
}

#modal-title {
    text-style: bold;
    color: #38bdf8;
    text-align: center;
    margin-bottom: 1;
}

.field-label {
    color: #94a3b8;
    margin-top: 1;
}

Input, Select {
    border: solid #475569;
    background: #0f172a;
    color: #f8fafc;
}

Input:focus, Select:focus {
    border: solid #38bdf8;
}

#modal-buttons {
    layout: horizontal;
    align: right middle;
    margin-top: 2;
    height: 3;
}

Button {
    margin-left: 1;
    border: none;
    background: #334155;
    color: #f8fafc;
}

Button:hover {
    background: #475569;
}

Button.primary {
    background: #0284c7;
    color: #ffffff;
    text-style: bold;
}

Button.primary:hover {
    background: #0369a1;
}

Button.success {
    background: #059669;
    color: #ffffff;
    text-style: bold;
}

Button.danger {
    background: #dc2626;
    color: #ffffff;
}

/* Dry Run Modal */
#dryrun-dialog {
    width: 80;
    height: 30;
    border: double #f59e0b;
    background: #1e293b;
    padding: 1 2;
}

#dryrun-log {
    height: 1fr;
    border: solid #334155;
    background: #0f172a;
    padding: 1;
}
